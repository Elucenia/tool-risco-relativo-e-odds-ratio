{
  "tool": {
    "id": "risco-relativo-e-odds-ratio",
    "title": "Risco relativo e odds ratio",
    "short": "Medidas de associação da tabela 2×2 com IC 95%",
    "desc": "Calcule risco relativo (coorte ou ensaio) ou odds ratio (caso-controle) de uma tabela 2×2, com intervalo de confiança de 95% e diferença de risco.",
    "lead": "Mede a associação entre uma exposição e um desfecho em estudos de coorte, ensaios clínicos (risco relativo) e estudos caso-controle (odds ratio).",
    "kind": "Calculadora",
    "spec": [
      "medicina-preventiva-e-social",
      "medicina-de-familia-e-comunidade",
      "medicina-do-trabalho"
    ],
    "fields": [
      [
        "desenho",
        "Desenho do estudo",
        "radio",
        {
          "opts": {
            "coorte": "Coorte ou ensaio clínico",
            "caso": "Caso-controle"
          }
        }
      ],
      [
        "a",
        "Expostos <strong>com</strong> o desfecho (a)",
        "num",
        {
          "min": 0,
          "max": 1000000,
          "step": 1,
          "ph": "20"
        }
      ],
      [
        "b",
        "Expostos <strong>sem</strong> o desfecho (b)",
        "num",
        {
          "min": 0,
          "max": 1000000,
          "step": 1,
